# Server Port
PORT=3000

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://username:password@cluster0.mongodb.net/sohail_portfolio?retryWrites=true&w=majority
MONGODB_URI=""

# JSON Web Token Secret for Admin Authentication
JWT_SECRET="sohail-dev-portfolio-jwt-secret-key-replace-in-production"

# GitHub profile username for telemetry stats
GITHUB_USERNAME="sohailshah"

# Base API URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
